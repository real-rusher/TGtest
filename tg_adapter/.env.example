# Von https://my.telegram.org (API development tools)
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# Von @BotFather
TG_BOT_TOKEN=123456789:AA...

# Telegram-User-IDs, die /pause und /resume nutzen dürfen (Komma-getrennt)
ADMIN_IDS=11111111

# Wohin eingehende Nachrichten und Zahlungen gepostet werden (leer = nur Log)
INBOUND_URL=http://core:9000/inbound
PAYMENT_URL=http://core:9000/payment
INBOUND_TOKEN=

# Outbound-API, die der Core aufruft
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
OUTBOUND_TOKEN=bitte-ein-langes-zufaelliges-passwort

MAX_DELAY=30
LOG_LEVEL=INFO
