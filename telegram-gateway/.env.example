# Von https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Gemeinsames Geheimnis für POST /send (lang und zufällig, z. B. openssl rand -hex 32)
API_TOKEN=bitte-ersetzen

# Wohin eingehende Nachrichten geschickt werden (Orchestrator)
INBOUND_WEBHOOK_URL=http://orchestrator:8090/inbound
INBOUND_WEBHOOK_TOKEN=

# HTTP-Schnittstelle des Gateways (im Docker-Container 0.0.0.0)
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

# Dateien
SESSION_PATH=data/gateway
PAUSE_FILE=data/paused.json

# Verhalten
MAX_DELAY=120
MAX_FLOOD_WAIT=300
AUTO_READ=true
LINK_PREVIEW=true
PAUSE_BLOCKS_OUTBOUND=true
LOG_LEVEL=INFO
