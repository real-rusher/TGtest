# Vorlage für einen Shop-Assistenten: Chatten ist gratis, die KI berät und verlinkt Produkte.
# Bezahlt wird im Shop des Klienten, dieses System wickelt keine Zahlungen ab.
# Kopieren nach .env und ausfüllen. Leere Werte = Standard.

BOT_MODE=shop
SHOP_NAME=

# --- Docker
# Pro Klient ein eigener Projektname und Port, wenn mehrere auf einem Server laufen
COMPOSE_PROJECT_NAME=shopbot
ORCHESTRATOR_PORT=8091

# --- Telegram (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=

# --- Interne Geheimnisse (jeweils: openssl rand -hex 32)
GATEWAY_TOKEN=
INBOUND_TOKEN=
POSTGRES_PASSWORD=

# --- Dateien im Ordner config/
PERSONA_FILE=/config/persona.md
CATALOG_FILE=/config/catalog.json

# --- Produktlinks
# Wird an jeden Produktlink gehängt, damit der Shop Besuche aus dem Chat zuordnen kann
LINK_QUERY=utm_source=telegram&utm_medium=chat
# Höchstens so viele Links pro Antwort
MAX_LINKS=3
# Bei großen Katalogen: so viele passende Produkte bekommt die KI pro Antwort zu sehen
CATALOG_PROMPT_LIMIT=40

# --- Sprachmodell (jeder OpenAI-kompatible Endpunkt)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.6
FACT_MODEL=gpt-4o-mini

# --- Verhalten
# Ohne Guthaben ist das Limit der Schutz vor Missbrauch und hohen Modellkosten
DAILY_REPLY_LIMIT=150
DEBOUNCE_SECONDS=3
HISTORY_LIMIT=30
FACT_EVERY=6
FACT_WINDOW=20
LOG_LEVEL=INFO

# --- Texte. Leer = Standardtext. \n = Zeilenumbruch.
# Der Standard-Hinweis nennt SHOP_NAME, damit erkennbar ist, dass ein Shop-Assistent schreibt.
# Er lässt sich umformulieren ({shop_name} wird ersetzt), aber nicht abschalten.
TEXT_DISCLOSURE=
TEXT_STOP=
TEXT_START=
TEXT_DELETE_WARN=
TEXT_DELETE_DONE=
