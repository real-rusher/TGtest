# =============================================================================
#  ZUGANGSDATEN UND EINSTELLUNGEN
#
#  Diese Datei nach ".env" kopieren und ausfüllen:   ./setup.sh   (erzeugt auch die Passwörter)
#  Die .env niemals weitergeben oder in Git hochladen.
#
#  Das Verhalten des Bots (Persona, Produkte, Zahlungsart) steht in config/bot.yaml.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) SPRACHMODELL  (Pflicht)
# -----------------------------------------------------------------------------
# Anbieter:
#   anthropic  Claude (console.anthropic.com)
#   openai     OpenAI oder jeder OpenAI-kompatible Dienst (OpenRouter, Groq, Mistral,
#              Together, lokale Server wie Ollama). Dann LLM_BASE_URL setzen.
LLM_PROVIDER=anthropic

# API-Key des Anbieters
LLM_API_KEY=

# Modellname. Leer lassen bei anthropic = claude-opus-5-5.
# Beispiele: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5 | bei openai Pflicht
LLM_MODEL=

# Nur für OpenAI-kompatible Dienste, z. B.:
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   http://host.docker.internal:11434/v1   (Ollama auf demselben Server)
LLM_BASE_URL=

# Optional: günstigeres Modell nur für das Gedächtnis (Fakten merken)
FACTS_MODEL=

# Nur Claude: Denktiefe low | medium | high (low ist für Chats meist ideal und am günstigsten)
LLM_EFFORT=low
# Nur Claude: lehnt das Modell eine Antwort ab, übernimmt automatisch ein anderes Claude-Modell
LLM_FALLBACKS=true


# -----------------------------------------------------------------------------
# 2) TELEGRAM  (Pflicht)
# -----------------------------------------------------------------------------
# bot      = Bot-Account von @BotFather (empfohlen, nötig für Telegram Stars)
# userbot  = normaler Telegram-Account (einmaliger Login nötig, siehe README)
TELEGRAM_MODE=bot

# Von https://my.telegram.org -> "API development tools" (für beide Modi nötig)
TG_API_ID=
TG_API_HASH=

# Nur Modus bot: Token von @BotFather
TG_BOT_TOKEN=

# Nur Modus bot: Telegram-IDs, die /pause <id> und /resume <id> nutzen dürfen (Komma-getrennt)
ADMIN_IDS=


# -----------------------------------------------------------------------------
# 3) ZAHLUNGEN  (nur das ausfüllen, was in config/bot.yaml gewählt ist)
# -----------------------------------------------------------------------------
# Stripe: Signing Secret des Webhooks (whsec_...), Webhook-URL: https://DOMAIN/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Eigener Bezahl-Webhook (PayPal über Zapier/Make, Digistore, ...): https://DOMAIN/webhooks/payment
PAYMENT_WEBHOOK_TOKEN=


# -----------------------------------------------------------------------------
# 4) ÖFFENTLICHER ZUGANG  (nur für Stripe/Webhooks oder Admin von außen nötig)
# -----------------------------------------------------------------------------
# Domain, die auf diesen Server zeigt, z. B. bot.example.com
DOMAIN=
# "https" einschalten, sobald DOMAIN gesetzt ist (startet Caddy mit automatischem Zertifikat)
COMPOSE_PROFILES=


# -----------------------------------------------------------------------------
# 5) INTERNE PASSWÖRTER  (setup.sh füllt diese automatisch)
# -----------------------------------------------------------------------------
INTERNAL_TOKEN=
ADMIN_TOKEN=
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
