# Kopieren nach .env und ausfüllen. Gilt für docker-compose.yml im Repo-Root.

# --- Telegram (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=

# --- Interne Geheimnisse (jeweils: openssl rand -hex 32)
GATEWAY_TOKEN=
INBOUND_TOKEN=
POSTGRES_PASSWORD=

# --- Sprachmodell (jeder OpenAI-kompatible Endpunkt)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.9
FACT_MODEL=gpt-4o-mini

# --- Zahlungen: stripe (echt) oder dummy (Testseite ohne Geld, nur Entwicklung)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Wohin Stripe nach der Zahlung weiterleitet, z. B. ein t.me-Link zurück in den Chat
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
# Öffentliche Adresse des Orchestrators (nur für PAYMENT_PROVIDER=dummy nötig)
PUBLIC_BASE_URL=

# --- Verhalten
FREE_CREDITS=20
OFFER_COOLDOWN_HOURS=12
PAYWALL_PRODUCT_ID=
DEBOUNCE_SECONDS=3
HISTORY_LIMIT=30
FACT_EVERY=6
FACT_WINDOW=20
LOG_LEVEL=INFO

# --- Texte (optional, \n für Zeilenumbruch; Platzhalter in geschweiften Klammern)
# TEXT_DISCLOSURE=
# TEXT_PAYWALL=          muss {link} enthalten, optional {title} {credits} {price}
# TEXT_PAYMENT_CONFIRM=  {balance}
# TEXT_STOP=
# TEXT_START=
# TEXT_BALANCE=          {balance}
# TEXT_DELETE_WARN=      {balance}
# TEXT_DELETE_DONE=
